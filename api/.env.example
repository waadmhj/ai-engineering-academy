# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./academy.db
# DATABASE_URL=postgresql+psycopg://academy:academy@localhost:5432/academy
AUTH_MODE=local            # local = single learner, no login | jwt = accounts with login
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Tutor Forge part 5 reads these (only once you've built it):
TUTOR_PROVIDER=none        # none | openai | anthropic | ollama
TUTOR_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434
